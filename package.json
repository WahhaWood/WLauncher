{
  "name": "wlauncher",
  "productName": "WLauncher",
  "version": "1.0.2",
  "description": "WLauncher — лаунчер модовой сборки",
  "author": "Wahha",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:linux": "electron-builder --linux appimage pacman --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ru.wlauncher.app",
    "productName": "WLauncher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "config.json",
      "vendor/packwiz/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon-1024.png",
      "category": "Game",
      "maintainer": "Wahha",
      "description": "WLauncher — лаунчер модовой сборки",
      "target": [
        "AppImage",
        "pacman"
      ],
      "desktop": {
        "entry": {
          "Name": "WLauncher",
          "Comment": "WLauncher — лаунчер модовой сборки"
        }
      }
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
